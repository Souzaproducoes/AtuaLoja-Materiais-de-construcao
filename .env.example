# Atua Loja — variáveis de ambiente para produção
# Configure estes valores no painel da Vercel.
# NÃO publique este ficheiro com valores reais no GitHub.

# ========================================
# Base de dados e sessões
# ========================================
# Não use 127.0.0.1 em produção: a Vercel não consegue aceder à sua base local.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=GERAR_UMA_CHAVE_LONGA_E_ALEATORIA

# ========================================
# Login administrativo local
# ========================================
LOCAL_ADMIN_USERNAME=admin@exemplo.com
LOCAL_ADMIN_PASSWORD=ALTERAR_PARA_UMA_PASSWORD_FORTE
LOCAL_ADMIN_NAME=Administrador Atua Loja
LOCAL_ADMIN_EMAIL=admin@exemplo.com
LOCAL_ADMIN_OPEN_ID=local_admin
# Em produção, mantenha false se não quiser login local.
ALLOW_LOCAL_ADMIN_LOGIN=true

# ========================================
# Supabase — opcional
# ========================================
SUPABASE_URL=https://SEU_PROJECTO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_APENAS_NO_SERVIDOR
VITE_SUPABASE_URL=https://SEU_PROJECTO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# ========================================
# LLM OpenAI-compatible
# O código actual suporta NVIDIA e Groq.
# Configure pelo menos um dos dois fornecedores.
# ========================================
NVIDIA_API_KEY=SUA_CHAVE_NVIDIA
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Alternativa/fallback opcional.
GROQ_API_KEY=SUA_CHAVE_GROQ
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ========================================
# Serviço externo de armazenamento — opcional
# ========================================
SERVICE_API_URL=https://SEU_SERVICO_DE_STORAGE
SERVICE_API_KEY=SUA_CHAVE_DO_SERVICO

# ========================================
# Google Maps — opcional
# ========================================
VITE_MAPS_API_KEY=SUA_CHAVE_GOOGLE_MAPS
VITE_MAPS_API_URL=https://maps.googleapis.com

# ========================================
# Analytics — opcional
# ========================================
VITE_GA_MEASUREMENT_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# A Vercel define a porta automaticamente; não é necessário configurar PORT.
